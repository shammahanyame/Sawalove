APP_ENV=production
APP_KEY=change-this-to-a-long-random-secret
APP_URL=https://api.example.com

DB_DSN=mysql:host=localhost;dbname=sawalove;charset=utf8mb4
DB_USER=sawalove
DB_PASSWORD=change-this

CORS_ALLOWED_ORIGINS=*

API_PHONE_AUTH_ENABLED=true
API_EMAIL_AUTH_ENABLED=true
API_GOOGLE_AUTH_ENABLED=false
API_APPLE_AUTH_ENABLED=false

SESSION_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Set to true ONLY for local development: returns the OTP in the API
# response instead of requiring real SMS delivery. Never enable in staging/production.
OTP_DEBUG_RESPONSE=false

# Brute-force protection for /auth/* endpoints (fixed window per IP)
AUTH_RATE_LIMIT_WINDOW=300
AUTH_RATE_LIMIT_MAX=20

# Comma-separated hosts allowed in user profile photo URLs (empty = this API host only)
UPLOAD_ALLOWED_HOSTS=

SMS_HTTP_URL=
SMS_HTTP_AUTH_HEADER=

UPLOAD_PUBLIC_PATH=uploads/profile-photos
MAX_UPLOAD_BYTES=5242880

# ── AI gateway ────────────────────────────────────────────────────────────
# The model API key lives ONLY here (server-side). It is never shipped in the
# app bundle, never returned by any endpoint, and never written to logs.
# Leave AI_PROVIDER_API_KEY empty to run AI features on safe static fallbacks.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini

# SPEND CAP: hard budget for model calls, per UTC day (whole US cents).
# Calls that would exceed it are refused BEFORE the provider is contacted.
AI_DAILY_SPEND_LIMIT_CENTS_USD=500
# Per-user per-UTC-day request quota (abuse bound on top of the money cap).
AI_USER_DAILY_REQUEST_LIMIT=20
# Conservative per-1M-token price used for cost estimation (whole USD).
AI_COST_USD_PER_1M_TOKENS=500
