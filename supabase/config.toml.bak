# SawaLove Supabase project config (created by `supabase init`, checked in so
# `supabase link` / `db push` / `functions deploy` work from a fresh clone).
# Fill project_id after linking; secrets stay in .env, never here.

project_id = "sawalove"

[api]
enabled = true
port = 54321
schemas = ["public", "storage", "graphql_public"]
extra_search_path = ["public", "extensions"]
max_rows = 1000

[db]
port = 54322
major_version = 15

[studio]
enabled = true
port = 54323

[auth]
enabled = true
site_url = "https://sawalove.com"
additional_redirect_urls = ["io.sawalove.app://login-callback"]
jwt_expiry = 3600
enable_refresh_token_rotation = true
refresh_token_reuse_interval = 10
enable_signup = true

[auth.email]
enable_signup = true
double_confirm_changes = true
enable_confirmations = true

# Password reset / recovery link expiry: 1 hour (security floor requested).
[auth.email.max_frequency]
# Supabase CLI < 1.145 ignores this block; dashboard setting remains source of
# truth on hosted projects (see migrations/20261009030000_auth_config.sql).

[auth.sms]
enable_signup = true
enable_confirmations = true

[storage]
enabled = true
file_size_limit = "5MiB"
